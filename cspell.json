{
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project-words"
  ],
  "ignorePaths": [
    "node_modules",
    "/project-words.txt",
    "docusaurus.config.ts"
  ],
  "patterns": [
    {
      "name": "mdx-component-tag",
      "pattern": "/<\\/?(?:Tabs|TabItem|ClientExampleSetup)\\b[^>]*>/g"
    },
    {
      "name": "markdown-code-block",
      "pattern": "/^[ \\t]*(`{3,}|~{3,})[^\\r\\n]*\\r?\\n[\\s\\S]*?^[ \\t]*\\1[ \\t]*$/gm"
    },
    {
      "name": "docusaurus-front-matter-identifier",
      "pattern": "/^(?:id|slug):\\s*[^\\r\\n]+$/gm"
    },
    {
      "name": "markdown-inline-code",
      "pattern": "/(?<!`)`[^`\\r\\n]+`(?!`)/g"
    }
  ],
  "languageSettings": [
    {
      "languageId": "markdown,mdx",
      "caseSensitive": true,
      "ignoreRegExpList": [
        "mdx-component-tag",
        "markdown-code-block",
        "docusaurus-front-matter-identifier",
        "markdown-inline-code"
      ]
    }
  ]
}
